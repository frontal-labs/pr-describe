{
  "name": "@frontal-labs/pr-describe",
  "version": "0.1.0",
  "private": false,
  "description": "Drafts PR descriptions and change records from the diff, and turns them into changelogs.",
  "keywords": [
    "github",
    "pull-requests",
    "changelog",
    "ai",
    "slack"
  ],
  "type": "module",
  "bin": {
    "pr-describe": "dist/cli.js"
  },
  "scripts": {
    "build": "bun run build:cli",
    "build:cli": "bun build src/cli.ts --outfile dist/cli.js --target node --format esm --external ggml-node",
    "eval": "bun run tests/eval.ts",
    "generate": "bun run build",
    "lint": "biome check src tests",
    "prepare": "husky",
    "release": "changeset publish",
    "test": "bun test"
  },
  "dependencies": {
    "@octokit/rest": "^20.0.2",
    "@t3-oss/env-core": "^0.13.11",
    "ggml-node": "^0.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@biomejs/cli-darwin-arm64": "^2.6.4",
    "@changesets/cli": "^2.29.8",
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@types/bun": "^1.3.5",
    "@typescript/typescript-darwin-arm64": "^7.0.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "ultracite": "^8.1.0"
  }
}
