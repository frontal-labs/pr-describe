{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "root": true,
  "extends": ["ultracite/biome/core"],
  "files": {
    "includes": [
      "src/**",
      "tests/**",
      "*.json",
      "*.jsonc",
      "*.md",
      "*.ts",
      "*.tsx",
      ".github/**",
      "!dist",
      "!node_modules"
    ]
  },
  "linter": {
    "rules": {
      "suspicious": {
        "noConsole": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useNamingConvention": "off",
        "noDefaultExport": "off",
        "noImplicitBoolean": "off",
        "useExplicitLengthCheck": "off",
        "useExportsLast": "off",
        "useSingleVarDeclarator": "off",
        "noExcessiveClassesPerFile": "off",
        "noExcessiveLinesPerFile": "off",
        "noHexColors": "off",
        "noJsxLiterals": "off",
        "noInlineStyles": "off",
        "useGlobalThis": "off",
        "noMagicNumbers": "off",
        "noProcessEnv": "off",
        "useConsistentCurlyBraces": "off",
        "noIncrementDecrement": "off",
        "useDestructuring": "off",
        "useThisInClassMethods": "off",
        "useConsistentMethodSignatures": "off",
        "useNamedCaptureGroup": "off",
        "useUnicodeRegex": "off",
        "useReadonlyClassProperties": "off"
      },
      "correctness": {
        "noNodejsModules": "off",
        "noUndeclaredDependencies": "off",
        "useImportExtensions": "off",
        "useJsonImportAttributes": "off",
        "noUnusedVariables": "off"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": "off",
        "noExcessiveLinesPerFunction": "off",
        "useMaxParams": "off",
        "noImplicitCoercions": "off"
      },
      "nursery": {
        "useTailwindSortedClasses": "off"
      },
      "performance": {
        "noBarrelFile": "off",
        "noReExportAll": "off",
        "useTopLevelRegex": "off",
        "noAwaitInLoops": "off"
      },
      "suspicious": {
        "useAwait": "off",
        "noTemplateCurlyInString": "off",
        "noUnnecessaryConditions": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/**/*.ts", "src/cli.ts", "src/action.ts"],
      "linter": {
        "rules": {
          "style": {
            "useTemplate": "off"
          }
        }
      }
    }
  ]
}